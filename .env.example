# .env.example — copy to .env for local development
# Never commit .env to git.

# Gmail OAuth2 (from GCP Console)
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER_ADDRESS=you@yourdomain.com

# OpenAI
OPENAI_API_KEY=sk-...

# Notion integration
NOTION_TOKEN=secret_...
NOTION_COMPANIES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_CONTACTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_OPPORTUNITIES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DIGEST_ARCHIVE_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # optional

# Digest config
DIGEST_RECIPIENT_EMAIL=yourteam@yourdomain.com
DIGEST_TEAM_NAME=My Sales Team
